<Window x:Class="ImageResizerCSharp.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilih Warna Kustom"
        Width="450"
        SizeToContent="Height"
        MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Segoe UI"
        Icon="app_icon.ico">

    <Window.Resources>
        <!-- Rainbow Hue Slider Style -->
        <Style x:Key="HueSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="360"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24">
                            <!-- Rainbow Track -->
                            <Border CornerRadius="6" Height="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0000" Offset="0.00"/>
                                        <GradientStop Color="#FFFF00" Offset="0.17"/>
                                        <GradientStop Color="#00FF00" Offset="0.33"/>
                                        <GradientStop Color="#00FFFF" Offset="0.50"/>
                                        <GradientStop Color="#0000FF" Offset="0.67"/>
                                        <GradientStop Color="#FF00FF" Offset="0.83"/>
                                        <GradientStop Color="#FF0000" Offset="1.00"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Track & Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFF" Stroke="#334155" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Title -->
            <RowDefinition Height="Auto"/> <!-- 1: 2D Spectrum & Color Preview -->
            <RowDefinition Height="Auto"/> <!-- 2: Rainbow Hue Slider -->
            <RowDefinition Height="Auto"/> <!-- 3: HEX Bar -->
            <RowDefinition Height="Auto"/> <!-- 4: Quick Palette -->
            <RowDefinition Height="Auto"/> <!-- 5: Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Text="Pilih Warna Latar Belakang" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

        <!-- 2. 2D Spectrum & Selected Color Box (Matched to requested UI) -->
        <Border Grid.Row="1" Height="150" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Solid Preview of Selected Color -->
                <Border Grid.Column="0" x:Name="boxSelectedColor" Background="#ba575e"/>

                <!-- Right: 2D Saturation-Value Canvas with circular thumb -->
                <Grid Grid.Column="1" x:Name="gridColorSpectrum" ClipToBounds="True" Cursor="Cross" SizeChanged="GridColorSpectrum_SizeChanged" MouseDown="ColorSpectrum_MouseDown" MouseMove="ColorSpectrum_MouseMove" MouseUp="ColorSpectrum_MouseUp">
                    <!-- Pure Hue Background -->
                    <Rectangle x:Name="rectHueBackground" Fill="#FF0000"/>

                    <!-- Horizontal Saturation (White to Transparent) -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Vertical Value/Brightness (Transparent to Black) -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0"/>
                                <GradientStop Color="#FF000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Circular Thumb Ring '○' -->
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="thumbSpectrum" Width="18" Height="18" Stroke="#FFFFFF" StrokeThickness="2.5" Margin="-9,-9,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Rainbow Hue Slider -->
        <Slider Grid.Row="2" x:Name="sliderHue" Style="{StaticResource HueSliderStyle}" ValueChanged="SliderHue_ValueChanged" Margin="0,0,0,10"/>

        <!-- 4. HEX Input Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="HEX" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="txtHexInput" Text="#ba575e" Height="28" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="TxtHexInput_TextChanged"/>
                <Button Grid.Column="2" x:Name="btnCopyHex" Content="Salin" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="8,2" FontSize="10" Click="BtnCopyHex_Click" ToolTip="Salin kode HEX"/>
            </Grid>
        </Border>

        <!-- 5. Curated Document Palette -->
        <Border Grid.Row="4" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Palet Dokumen Resmi / Pasfoto:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <WrapPanel x:Name="pnlPalette" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 6. Action Buttons -->
        <Grid Grid.Row="5" Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Batal" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,6,0" Click="BtnCancel_Click"/>
            <Button Grid.Column="1" Content="Terapkan Warna" Style="{StaticResource PrimaryButtonStyle}" Height="36" Margin="6,0,0,0" Click="BtnApply_Click"/>
        </Grid>
    </Grid>
</Window>
