<Window x:Class="ImageResizerCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ImageResizerCSharp.Models"
        xmlns:controls="clr-namespace:ImageResizerCSharp.Controls"
        mc:Ignorable="d"
        Title="Bulk Image Editor"
        Width="1260" Height="880"
        MinWidth="1060" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>    <!-- Top Bar -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Bottom Bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════ 1. TOP BAR ══════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Bulk Image Editor" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Kompresi ukuran file, resize, dan ganti warna background pas foto secara instan" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════ 2. MAIN CONTENT (3-COLUMN WORKSPACE) ══════════════════════════ -->
        <Grid Grid.Row="1" Margin="20,12,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="260"/>
                <!-- Col 0: File Queue -->
                <ColumnDefinition Width="12"/>
                <!-- Gap -->
                <ColumnDefinition Width="*" MinWidth="380"/>
                <!-- Col 2: Big Preview Canvas -->
                <ColumnDefinition Width="12"/>
                <!-- Gap -->
                <ColumnDefinition Width="360" MinWidth="340"/>
                <!-- Col 4: Settings in ScrollViewer -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT COLUMN (COL 0): FILE QUEUE ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Source Folder Bar -->
                    <RowDefinition Height="*"/>
                    <!-- File List Card -->
                </Grid.RowDefinitions>

                <!-- Source Folder Bar -->
                <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Folder Sumber:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtSourceFolder" Height="34" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,6,0" Text="Pilih folder gambar..."/>
                            <Button Grid.Column="1" x:Name="btnBrowseSource" Content="Browse..." Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="10,4" Click="BtnBrowseSource_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- File Queue Card (Full Height) -->
                <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Action / Summary Bar -->
                            <RowDefinition Height="*"/>
                            <!-- Scrollable ListView -->
                        </Grid.RowDefinitions>

                        <!-- Action Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock x:Name="txtFileListHeader" Text="Daftar Foto (0)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="txtFileListSummary" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <!-- Inline loading indicator while reading metadata/thumbnails -->
                                <StackPanel x:Name="pnlHeaderSpinner" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed">
                                    <controls:LoadingSpinner Width="12" Height="12" SpinnerColor="{StaticResource AccentBrush}" TrackColor="{StaticResource AccentBgBrush}" StrokeThickness="2" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtHeaderSpinnerMsg" Text="Membaca info..." FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="btnToggleSelectAll" Content="Pilih Semua" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnToggleSelectAll_Click"/>
                        </Grid>

                        <!-- Empty State View -->
                        <StackPanel x:Name="pnlEmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                            <TextBlock Text="Belum Ada Foto" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Pilih folder sumber di atas." FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Loading State View (Active while scanning directory) -->
                        <StackPanel x:Name="pnlLoadingState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <controls:LoadingSpinner Width="32" Height="32" SpinnerColor="{StaticResource AccentBrush}" TrackColor="{StaticResource BgInputBrush}" StrokeThickness="3" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Memuat Daftar..." FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="txtLoadingStateSub" Text="Memindai file gambar..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- File ListView (Virtualized StackPanel for 60fps scrolling) -->
                        <ListView x:Name="lstFiles" Grid.Row="1"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionMode="Single"
                                  SelectionChanged="LstFiles_SelectionChanged"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  Visibility="Collapsed">
                            <ListView.ContextMenu>
                                <ContextMenu Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}">
                                    <MenuItem Header="Putar Kiri 90° (↺)" Click="MenuItemRotateLeft_Click" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <MenuItem Header="Putar Kanan 90° (↻)" Click="MenuItemRotateRight_Click" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <MenuItem Header="Putar 180°" Click="MenuItemRotate180_Click" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Separator Background="{StaticResource BorderBrush}"/>
                                    <MenuItem Header="Terapkan Putaran ke Semua Foto" Click="MenuItemRotateAll_Click" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <MenuItem Header="Reset Putaran (0°)" Click="MenuItemResetRotation_Click" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="itemBorder" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="52" Padding="8,0">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AccentBgBrush}"/>
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="itemBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ImageItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Checkbox -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Micro Thumbnail -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Filename & Specs -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Status -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- Micro Photo Thumbnail (36x36 px) -->
                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Filename & Specs Text Stack -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding InfoText}" FontSize="10" Margin="0,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Status Indicator -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <controls:LoadingSpinner Width="11" Height="11" SpinnerColor="{StaticResource WarningBrush}" TrackColor="{StaticResource BgInputBrush}" StrokeThickness="2" Margin="0,0,4,0">
                                                <controls:LoadingSpinner.Style>
                                                    <Style TargetType="{x:Type controls:LoadingSpinner}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:LoadingSpinner.Style>
                                            </controls:LoadingSpinner>
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── CENTER COLUMN (COL 2): LARGE PREVIEW CANVAS (FULL HEIGHT!) ── -->
            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Row 0: Header & AI Action Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Dedicated Crop Sub-bar (Hanya muncul saat Crop Aktif) -->
                        <RowDefinition Height="*"/>
                        <!-- Row 2: Big Image Canvas -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 3: Metadata Specs Bar -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header & AI Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Preview Foto" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <!-- Rotate Controls -->
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="btnRotateLeft" Content="↺" Style="{StaticResource SecondaryButtonStyle}" Width="28" Height="28" Padding="0" FontSize="14" FontWeight="Bold" Margin="0,0,3,0" Click="BtnRotateLeft_Click" ToolTip="Putar 90° Berlawanan Jarum Jam (↺)"/>
                                <Button x:Name="btnRotateRight" Content="↻" Style="{StaticResource SecondaryButtonStyle}" Width="28" Height="28" Padding="0" FontSize="14" FontWeight="Bold" Margin="0,0,0,0" Click="BtnRotateRight_Click" ToolTip="Putar 90° Searah Jarum Jam (↻)"/>
                            </StackPanel>

                            <!-- Toggle Crop Mode Button -->
                            <ToggleButton x:Name="btnToggleCropMode" Content="✂ Crop" Style="{StaticResource CropToggleButtonStyle}" Margin="8,0,0,0" Click="BtnToggleCropMode_Click" ToolTip="Aktifkan kotak pemotongan crop interaktif di kanvas"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- AI Processing Indicator -->
                            <StackPanel x:Name="pnlAiLoading" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                                <controls:LoadingSpinner Width="13" Height="13" SpinnerColor="{StaticResource AccentBrush}" TrackColor="#20000000" StrokeThickness="2" Margin="0,0,6,0"/>
                                <TextBlock Text="AI Matting..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                            <!-- Segmented Compare Toggle: [ Foto Asli | ✨ Hasil AI ] -->
                            <Border x:Name="pnlCompareSegmented" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbViewOriginal" Content="Foto Asli" GroupName="CompareView" Style="{StaticResource CompareSegmentedRadioStyle}" Checked="CompareView_Checked" ToolTip="Tampilkan foto asli tanpa editan AI"/>
                                    <RadioButton x:Name="rbViewAi" Content="✨ Hasil AI" GroupName="CompareView" IsChecked="True" Style="{StaticResource CompareSegmentedRadioStyle}" Checked="CompareView_Checked" ToolTip="Tampilkan hasil pasfoto dengan AI background"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Sub-Baris Khusus Crop (Hanya muncul saat Crop Aktif) -->
                    <Border x:Name="pnlCropSubBar" Grid.Row="1" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Visibility="Collapsed">
                        <DockPanel LastChildFill="False">
                            <!-- Left: Ratio Locking Group -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <TextBlock Text="Kunci Rasio:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <RadioButton x:Name="rbCropRatioFree" Content="Bebas" GroupName="CropRatio" IsChecked="True" Style="{StaticResource SegmentedRadioStyle}" FontSize="10.5" Padding="7,3" Margin="2,0" Checked="CropRatio_Checked"/>
                                <RadioButton x:Name="rbCropRatio2x3" Content="2:3" GroupName="CropRatio" Style="{StaticResource SegmentedRadioStyle}" FontSize="10.5" Padding="7,3" Margin="2,0" Checked="CropRatio_Checked"/>
                                <RadioButton x:Name="rbCropRatio3x4" Content="3:4" GroupName="CropRatio" Style="{StaticResource SegmentedRadioStyle}" FontSize="10.5" Padding="7,3" Margin="2,0" Checked="CropRatio_Checked"/>
                                <RadioButton x:Name="rbCropRatio4x6" Content="4:6" GroupName="CropRatio" Style="{StaticResource SegmentedRadioStyle}" FontSize="10.5" Padding="7,3" Margin="2,0" Checked="CropRatio_Checked"/>
                                <RadioButton x:Name="rbCropRatio1x1" Content="1:1" GroupName="CropRatio" Style="{StaticResource SegmentedRadioStyle}" FontSize="10.5" Padding="7,3" Margin="2,0" Checked="CropRatio_Checked"/>
                            </StackPanel>

                            <!-- Right: Action Buttons (Reset, Batal, Selesai) with distinct colors -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                                <Button x:Name="btnResetCrop" Content="↺ Reset" Style="{StaticResource ResetCropButtonStyle}" Height="26" Padding="10,2" FontSize="11" Margin="0,0,6,0" Click="BtnResetCrop_Click" ToolTip="Kembalikan kotak crop ke ukuran penuh"/>
                                <Button x:Name="btnCancelCrop" Content="✕ Batal" Style="{StaticResource CancelCropButtonStyle}" Height="26" Padding="10,2" FontSize="11" Margin="0,0,6,0" Click="BtnCancelCrop_Click" ToolTip="Batalkan perubahan pemotongan dan kembali ke tampilan sebelumnya"/>
                                <Button x:Name="btnApplyCrop" Content="✓ Selesai" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="12,2" FontSize="11" FontWeight="SemiBold" Click="BtnApplyCrop_Click" ToolTip="Terapkan framing crop dan kembali ke live preview"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Big Image Canvas Box (Expands to fill entire height and width) -->
                    <Border Grid.Row="2" Background="{StaticResource BgPreviewBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                        <Grid x:Name="gridPreviewContainer" SizeChanged="GridPreviewContainer_SizeChanged">
                            <!-- Checkerboard/Empty placeholder -->
                            <StackPanel x:Name="pnlPreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource BgInputBrush}" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <TextBlock Text="🖼" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Pilih foto di daftar sebelah kiri" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                                <TextBlock Text="Preview pasfoto &amp; AI background akan tampil di sini" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Responsive Image Display -->
                            <Image x:Name="imgPreview" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Interactive Crop Overlay Canvas -->
                            <Canvas x:Name="cropCanvas" Visibility="Collapsed" ClipToBounds="True">
                                <!-- Dimmed Overlay Path outside Crop Box -->
                                <Path x:Name="cropMaskPath" Fill="#75000000" IsHitTestVisible="False"/>

                                <!-- Interactive Move Thumb (the Crop Box itself) -->
                                <Thumb x:Name="cropBoxThumb" Cursor="SizeAll" DragDelta="CropBoxThumb_DragDelta">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border BorderBrush="#3B82F6" BorderThickness="2" Background="#153B82F6">
                                                <!-- Grid Rule of Thirds Lines -->
                                                <Grid IsHitTestVisible="False">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Height="1" Fill="#60FFFFFF" VerticalAlignment="Bottom"/>
                                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" Fill="#60FFFFFF" VerticalAlignment="Bottom"/>
                                                    <Rectangle Grid.Column="0" Grid.RowSpan="3" Width="1" Fill="#60FFFFFF" HorizontalAlignment="Right"/>
                                                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Width="1" Fill="#60FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                                <!-- 8 Resize Handles -->
                                <Thumb x:Name="thumbNW" Style="{StaticResource CropThumbStyle}" Cursor="SizeNWSE" DragDelta="Handle_DragDelta" Tag="NW"/>
                                <Thumb x:Name="thumbNE" Style="{StaticResource CropThumbStyle}" Cursor="SizeNESW" DragDelta="Handle_DragDelta" Tag="NE"/>
                                <Thumb x:Name="thumbSW" Style="{StaticResource CropThumbStyle}" Cursor="SizeNESW" DragDelta="Handle_DragDelta" Tag="SW"/>
                                <Thumb x:Name="thumbSE" Style="{StaticResource CropThumbStyle}" Cursor="SizeNWSE" DragDelta="Handle_DragDelta" Tag="SE"/>

                                <Thumb x:Name="thumbN" Style="{StaticResource CropThumbStyle}" Cursor="SizeNS" DragDelta="Handle_DragDelta" Tag="N"/>
                                <Thumb x:Name="thumbS" Style="{StaticResource CropThumbStyle}" Cursor="SizeNS" DragDelta="Handle_DragDelta" Tag="S"/>
                                <Thumb x:Name="thumbW" Style="{StaticResource CropThumbStyle}" Cursor="SizeWE" DragDelta="Handle_DragDelta" Tag="W"/>
                                <Thumb x:Name="thumbE" Style="{StaticResource CropThumbStyle}" Cursor="SizeWE" DragDelta="Handle_DragDelta" Tag="E"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Bottom Specs Bar -->
                    <Border Grid.Row="3" Background="{StaticResource BgInputBrush}" CornerRadius="6" Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="txtSpecDims" Text="Resolusi: -" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="txtSpecSize" Text="Ukuran: -" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" x:Name="txtSpecFmt" Text="Format: -" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ── RIGHT COLUMN (COL 4): SETTINGS PANEL (SCROLLABLE & TIDY) ── -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Pengaturan Pas Foto &amp; Output" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <!-- ══ SECTION 1: LATAR BELAKANG PAS FOTO AI (VISUAL COLOR BUTTONS) ══ -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Latar Belakang:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource AccentBgBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="Pasfoto ID" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Visual Color Buttons (UniformGrid 2 Columns for comfortable breathing room) -->
                        <UniformGrid x:Name="pnlBgButtons" Columns="2" Margin="0,0,0,4">
                            <!-- 1. Asli / None -->
                            <RadioButton x:Name="rbBgNone" IsChecked="True" GroupName="BgPresets" Style="{StaticResource ColorSwatchRadioStyle}" Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#334155" Checked="BgPreset_Checked" ToolTip="Pertahankan latar belakang asli tanpa diubah">
                                <TextBlock Text="Asli" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton>

                            <!-- 2. Merah (Ganjil) -->
                            <RadioButton x:Name="rbBgRed" GroupName="BgPresets" Style="{StaticResource ColorSwatchRadioStyle}" Background="#DC2626" BorderBrush="#B91C1C" Foreground="#FFFFFF" Checked="BgPreset_Checked" ToolTip="Pasfoto Merah standar tahun kelahiran ganjil (KTP/Ijazah/CPNS)">
                                <TextBlock Text="Merah" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton>

                            <!-- 3. Biru (Genap) -->
                            <RadioButton x:Name="rbBgBlue" GroupName="BgPresets" Style="{StaticResource ColorSwatchRadioStyle}" Background="#0284C7" BorderBrush="#0369A1" Foreground="#FFFFFF" Checked="BgPreset_Checked" ToolTip="Pasfoto Biru standar tahun kelahiran genap (KTP/Ijazah/CPNS)">
                                <TextBlock Text="Biru" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton>

                            <!-- 4. Putih (Visa / Paspor) -->
                            <RadioButton x:Name="rbBgWhite" GroupName="BgPresets" Style="{StaticResource ColorSwatchRadioStyle}" Background="#FFFFFF" BorderBrush="#94A3B8" Foreground="#0F172A" Checked="BgPreset_Checked" ToolTip="Pasfoto Putih standar dokumen visa &amp; paspor resmi">
                                <TextBlock Text="Putih" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton>

                            <!-- 5. Transparan (PNG Cutout) -->
                            <RadioButton x:Name="rbBgTransparent" GroupName="BgPresets" Style="{StaticResource ColorSwatchRadioStyle}" Background="#1E293B" BorderBrush="#334155" Foreground="#FFFFFF" Checked="BgPreset_Checked" ToolTip="Hapus latar belakang foto (otomatis diekspor dalam format PNG)">
                                <TextBlock Text="Transparan" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton>

                            <!-- 6. Kustom Palette / Hex -->
                            <RadioButton x:Name="rbBgCustom" GroupName="BgPresets" Style="{StaticResource ColorSwatchRadioStyle}" Background="#6366F1" BorderBrush="#4F46E5" Foreground="#FFFFFF" Checked="BgPreset_Checked" Click="RbBgCustom_Click" ToolTip="Pilih warna kustom dari palet warna (klik untuk ganti warna)">
                                <TextBlock x:Name="txtRbBgCustom" Text="Kustom" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock x:Name="txtBgHint" Text="Pertahankan background asli tanpa perubahan" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,0,0,8"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,8"/>

                        <!-- ══ SECTION 2: UKURAN PAS FOTO ══ -->
                        <TextBlock Text="Ukuran Pas Foto:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <UniformGrid x:Name="pnlPresetButtons" Columns="3" Margin="0,0,0,4">
                            <RadioButton x:Name="rbPresetOriginal" Content="Original" IsChecked="True" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPreset2x3" Content="2 × 3 cm" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPreset3x4" Content="3 × 4 cm" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPreset4x6" Content="4 × 6 cm" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPreset1x1" Content="1 : 1" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPresetCustom" Content="Kustom" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                        </UniformGrid>
                        <TextBlock x:Name="txtPresetHint" Text="Pertahankan rasio asli tanpa crop" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,0,0,8"/>

                        <!-- Custom Width & Height Row (Hidden by default) -->
                        <StackPanel x:Name="pnlCustomDimensions" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Lebar (px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtCustomW" Text="600" Width="70" Height="30" Padding="4,0" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,12,0" TextChanged="TxtCustomDims_TextChanged"/>
                            <TextBlock Text="Tinggi (px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtCustomH" Text="800" Width="70" Height="30" Padding="4,0" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="TxtCustomDims_TextChanged"/>
                        </StackPanel>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,8"/>

                        <!-- ══ SECTION 3: BATAS MAKSIMAL UKURAN FILE ══ -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Batas Maksimal File:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtMaxSizeDisplay" Text="1024 KB (1.0 MB)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="200 KB" Style="{StaticResource PillButtonStyle}" Click="QuickSize_Click" Tag="200" Margin="0,0,6,0"/>
                            <Button Content="500 KB" Style="{StaticResource PillButtonStyle}" Click="QuickSize_Click" Tag="500" Margin="0,0,6,0"/>
                            <Button Content="1 MB" Style="{StaticResource PillButtonStyle}" Click="QuickSize_Click" Tag="1024" Margin="0,0,6,0"/>
                            <Button Content="2 MB" Style="{StaticResource PillButtonStyle}" Click="QuickSize_Click" Tag="2048"/>
                        </StackPanel>

                        <Slider x:Name="sliderMaxSize" Minimum="50" Maximum="5000" Value="1024" Height="22" ValueChanged="SliderMaxSize_ValueChanged" Margin="0,2,0,6"/>

                        <!-- Maximize resolution / quality toggle -->
                        <CheckBox x:Name="chkMaximizeQuality"
                                  Content="Maksimalkan resolusi &amp; kualitas hingga mendekati target"
                                  IsChecked="True"
                                  FontSize="11"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  ToolTip="Menyesuaikan resolusi foto agar ukuran file sedekat mungkin dengan batas maksimal dengan kualitas visual tertinggi (90 - 95%)"
                                  Margin="0,0,0,8"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,8"/>

                        <!-- ══ SECTION 4: FORMAT OUTPUT ══ -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Format Output:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="rbFmtJpeg" Content="JPEG" IsChecked="True" GroupName="Formats" Style="{StaticResource SegmentedRadioStyle}" Margin="0,0,6,0"/>
                                <RadioButton x:Name="rbFmtPng" Content="PNG" GroupName="Formats" Style="{StaticResource SegmentedRadioStyle}" Margin="0,0,6,0"/>
                                <RadioButton x:Name="rbFmtWebp" Content="WEBP" GroupName="Formats" Style="{StaticResource SegmentedRadioStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,8"/>

                        <!-- ══ SECTION 5: FOLDER OUTPUT ══ -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Folder Output:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="chkOverwrite" Content="Timpa file asli" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Click="ChkOverwrite_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtOutputFolder" Height="34" VerticalContentAlignment="Center" Margin="0,0,6,0" Text="Default: folder_sumber/edited/"/>
                            <Button Grid.Column="1" x:Name="btnBrowseOutput" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}" Height="34" MinWidth="80" Padding="10,4" Click="BtnBrowseOutput_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════ 3. BOTTOM BAR ══════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Status & Progress -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Action Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Left: Status & Progress -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <controls:LoadingSpinner x:Name="spinnerBottomStatus" Width="14" Height="14" SpinnerColor="{StaticResource AccentBrush}" TrackColor="{StaticResource AccentBgBrush}" StrokeThickness="2" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="txtBottomStatus" Text="Siap - Pilih folder foto untuk memulai" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid>
                        <ProgressBar x:Name="pbProgress" Value="0" Maximum="100"/>
                        <TextBlock x:Name="txtProgressPct" Text="0%" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,-18,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnOpenFolder" Content="Buka Folder" Style="{StaticResource SecondaryButtonStyle}" Height="40" MinWidth="120" Padding="16,8" IsEnabled="False" Margin="0,0,10,0" Click="BtnOpenFolder_Click"/>
                    <Button x:Name="btnStartResize" Style="{StaticResource PrimaryButtonStyle}" Height="40" MinWidth="150" Padding="18,8" IsEnabled="False" Click="BtnStartResize_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:LoadingSpinner x:Name="spinnerResizeBtn" Width="15" Height="15" SpinnerColor="#FFFFFF" TrackColor="#40FFFFFF" StrokeThickness="2.2" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtStartResizeBtn" Text="Mulai" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
