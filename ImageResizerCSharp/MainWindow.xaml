<Window x:Class="ImageResizerCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ImageResizerCSharp.Models"
        xmlns:controls="clr-namespace:ImageResizerCSharp.Controls"
        mc:Ignorable="d"
        Title="Bulk Image Resizer &amp; Pas Foto"
        Width="1260" Height="880"
        MinWidth="1060" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>  <!-- Main Content -->
            <RowDefinition Height="76"/> <!-- Bottom Bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════ 1. TOP BAR ══════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Bulk Image Resizer" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentBgBrush}" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Pas Foto &amp; Batch" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Kompresi ukuran file dan resize pas foto (2x3, 3x4, 4x6) secara instan" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════ 2. MAIN CONTENT ══════════════════════════ -->
        <Grid Grid.Row="1" Margin="20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MinWidth="470"/> <!-- Left: File Queue -->
                <ColumnDefinition Width="14"/>                <!-- Column Gap -->
                <ColumnDefinition Width="5*" MinWidth="450"/> <!-- Right: Preview & Settings -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT COLUMN: FILE QUEUE ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Source Folder Bar -->
                    <RowDefinition Height="*"/>    <!-- File List Card -->
                </Grid.RowDefinitions>

                <!-- Source Folder Bar -->
                <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Folder Sumber:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="txtSourceFolder" Height="36" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,8,0" Text="Pilih folder berisi gambar..."/>
                        <Button Grid.Column="2" x:Name="btnBrowseSource" Content="Browse..." Style="{StaticResource PrimaryButtonStyle}" Height="36" MinWidth="95" Padding="14,6" Click="BtnBrowseSource_Click"/>
                    </Grid>
                </Border>

                <!-- File Queue Card (Full Height) -->
                <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Action / Summary Bar -->
                            <RowDefinition Height="*"/>    <!-- Scrollable ListView -->
                        </Grid.RowDefinitions>

                        <!-- Action Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="txtFileListHeader" Text="Daftar Foto (0)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="txtFileListSummary" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,2,0,0"/>
                                <!-- Inline loading indicator while reading metadata/thumbnails -->
                                <StackPanel x:Name="pnlHeaderSpinner" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,2,0,0" Visibility="Collapsed">
                                    <controls:LoadingSpinner Width="13" Height="13" SpinnerColor="{StaticResource AccentBrush}" TrackColor="{StaticResource AccentBgBrush}" StrokeThickness="2" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtHeaderSpinnerMsg" Text="Membaca info..." FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="btnToggleSelectAll" Content="Pilih Semua" Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="105" Padding="14,6" HorizontalAlignment="Right" Click="BtnToggleSelectAll_Click"/>
                        </Grid>

                        <!-- Empty State View -->
                        <StackPanel x:Name="pnlEmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Belum Ada Foto" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Pilih folder sumber di bagian atas untuk memuat daftar foto." FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Loading State View (Active while scanning directory) -->
                        <StackPanel x:Name="pnlLoadingState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <controls:LoadingSpinner Width="36" Height="36" SpinnerColor="{StaticResource AccentBrush}" TrackColor="{StaticResource BgInputBrush}" StrokeThickness="3" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Memuat Daftar Foto..." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="txtLoadingStateSub" Text="Memindai file gambar dari folder sumber..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- File ListView (Virtualized StackPanel for 60fps scrolling) -->
                        <ListView x:Name="lstFiles" Grid.Row="1"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionMode="Single"
                                  SelectionChanged="LstFiles_SelectionChanged"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="itemBorder" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="54" Padding="10,0">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AccentBgBrush}"/>
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="itemBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ImageItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                            <ColumnDefinition Width="Auto"/> <!-- Micro Thumbnail -->
                                            <ColumnDefinition Width="*"/>    <!-- Filename & Specs -->
                                            <ColumnDefinition Width="Auto"/> <!-- Status -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Micro Photo Thumbnail (38x38 px) -->
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="6" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Filename & Specs Text Stack -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding InfoText}" FontSize="11" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Status Indicator -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <controls:LoadingSpinner Width="12" Height="12" SpinnerColor="{StaticResource WarningBrush}" TrackColor="{StaticResource BgInputBrush}" StrokeThickness="2" Margin="0,0,5,0">
                                                <controls:LoadingSpinner.Style>
                                                    <Style TargetType="{x:Type controls:LoadingSpinner}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:LoadingSpinner.Style>
                                            </controls:LoadingSpinner>
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── RIGHT COLUMN: PREVIEW & SETTINGS ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*"/> <!-- Preview Card -->
                    <RowDefinition Height="Auto"/> <!-- Settings Card -->
                </Grid.RowDefinitions>

                <!-- Preview Card (Top Half) -->
                <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="*"/>    <!-- Image Canvas -->
                            <RowDefinition Height="Auto"/> <!-- Metadata Specs Bar -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Preview Gambar" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                        <!-- Image Preview Box -->
                        <Border Grid.Row="1" Background="{StaticResource BgPreviewBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6">
                            <Grid>
                                <StackPanel x:Name="pnlPreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Pilih foto di daftar sebelah kiri&#x0a;untuk melihat preview" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/>
                                </StackPanel>
                                <Image x:Name="imgPreview" Stretch="Uniform" Margin="8"/>
                            </Grid>
                        </Border>

                        <!-- Specs Bar -->
                        <Grid Grid.Row="2" Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="txtSpecDims" Text="Resolusi: -" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" x:Name="txtSpecSize" Text="Ukuran: -" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtSpecFmt" Text="Format: -" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Settings Card (Bottom Half) -->
                <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Pengaturan Resize &amp; Output" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <!-- Section A: Pas Foto Presets in 3-column UniformGrid -->
                        <TextBlock Text="Ukuran Pas Foto:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <UniformGrid x:Name="pnlPresetButtons" Columns="3" Margin="0,0,0,4">
                            <RadioButton x:Name="rbPresetOriginal" Content="Original" IsChecked="True" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPreset2x3" Content="2 × 3 cm" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPreset3x4" Content="3 × 4 cm" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPreset4x6" Content="4 × 6 cm" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPreset1x1" Content="1 : 1" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                            <RadioButton x:Name="rbPresetCustom" Content="Kustom" GroupName="Presets" Style="{StaticResource SegmentedRadioStyle}" Checked="Preset_Checked"/>
                        </UniformGrid>
                        <TextBlock x:Name="txtPresetHint" Text="Pertahankan rasio asli tanpa crop" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,8"/>

                        <!-- Custom Width & Height Row (Hidden by default) -->
                        <StackPanel x:Name="pnlCustomDimensions" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Lebar (px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtCustomW" Text="600" Width="75" Height="32" Padding="4,0" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="Tinggi (px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtCustomH" Text="800" Width="75" Height="32" Padding="4,0" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Section B: Max File Size -->
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="Batas Maksimal File:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtMaxSizeDisplay" Text="1024 KB (1.0 MB)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="200 KB" Style="{StaticResource PillButtonStyle}" Click="QuickSize_Click" Tag="200" Margin="0,0,6,0"/>
                            <Button Content="500 KB" Style="{StaticResource PillButtonStyle}" Click="QuickSize_Click" Tag="500" Margin="0,0,6,0"/>
                            <Button Content="1 MB" Style="{StaticResource PillButtonStyle}" Click="QuickSize_Click" Tag="1024" Margin="0,0,6,0"/>
                            <Button Content="2 MB" Style="{StaticResource PillButtonStyle}" Click="QuickSize_Click" Tag="2048"/>
                        </StackPanel>

                        <Slider x:Name="sliderMaxSize" Minimum="50" Maximum="5000" Value="1024" Height="22" ValueChanged="SliderMaxSize_ValueChanged" Margin="0,2,0,6"/>

                        <!-- Maximize resolution / quality toggle -->
                        <CheckBox x:Name="chkMaximizeQuality"
                                  Content="Maksimalkan resolusi &amp; kualitas hingga mendekati target"
                                  IsChecked="True"
                                  FontSize="11"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  ToolTip="Menyesuaikan resolusi foto agar ukuran file sedekat mungkin dengan batas maksimal (misal 460 - 495 KB untuk target 500 KB) dengan kualitas visual tertinggi (90 - 95%)"
                                  Margin="0,0,0,10"/>

                        <!-- Section C: Format Output -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Format Output:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="rbFmtJpeg" Content="JPEG" IsChecked="True" GroupName="Formats" Style="{StaticResource SegmentedRadioStyle}" Margin="0,0,6,0"/>
                                <RadioButton x:Name="rbFmtPng" Content="PNG" GroupName="Formats" Style="{StaticResource SegmentedRadioStyle}" Margin="0,0,6,0"/>
                                <RadioButton x:Name="rbFmtWebp" Content="WEBP" GroupName="Formats" Style="{StaticResource SegmentedRadioStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Section D: Folder Output (Spacious Full Width Row) -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Folder Output:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="chkOverwrite" Content="Timpa file asli (overwrite)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Click="ChkOverwrite_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtOutputFolder" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0" Text="Default: folder_sumber/resized/"/>
                            <Button Grid.Column="1" x:Name="btnBrowseOutput" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="90" Padding="14,6" Click="BtnBrowseOutput_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════ 3. BOTTOM BAR ══════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- Status & Progress -->
                    <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Left: Status & Progress -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <controls:LoadingSpinner x:Name="spinnerBottomStatus" Width="14" Height="14" SpinnerColor="{StaticResource AccentBrush}" TrackColor="{StaticResource AccentBgBrush}" StrokeThickness="2" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="txtBottomStatus" Text="Siap - Pilih folder foto untuk memulai" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid>
                        <ProgressBar x:Name="pbProgress" Value="0" Maximum="100"/>
                        <TextBlock x:Name="txtProgressPct" Text="0%" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,-18,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnOpenFolder" Content="Buka Folder" Style="{StaticResource SecondaryButtonStyle}" Height="40" MinWidth="120" Padding="16,8" IsEnabled="False" Margin="0,0,10,0" Click="BtnOpenFolder_Click"/>
                    <Button x:Name="btnStartResize" Style="{StaticResource PrimaryButtonStyle}" Height="40" MinWidth="150" Padding="18,8" IsEnabled="False" Click="BtnStartResize_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:LoadingSpinner x:Name="spinnerResizeBtn" Width="15" Height="15" SpinnerColor="#FFFFFF" TrackColor="#40FFFFFF" StrokeThickness="2.2" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtStartResizeBtn" Text="Mulai Resize" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
